      "frame_incognito_inactive": [14, 13, 20],
      "background_tab": [25, 23, 36],
      "background_tab_inactive": [20, 18, 29],
      "background_tab_incognito": [17, 16, 24],
      "background_tab_incognito_inactive": [14, 13, 20],
      "toolbar": [31, 29, 46],
      "toolbar_text": [224, 222, 244],
      "toolbar_button_icon": [144, 140, 170],
      "bookmark_text": [224, 222, 244],
      "ntp_background": [18, 16, 26],
      "ntp_text": [224, 222, 244],
      "ntp_link": [196, 167, 231],
      "button_background": [38, 35, 58],
      "omnibox_background": [14, 13, 20],
      "omnibox_text": [224, 222, 244],
      "tab_text": [224, 222, 244],
      "tab_background_text": [144, 140, 170],
