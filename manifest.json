{
  "manifest_version": 3,
  "name": "Rosé Pine — Afterglow",
  "short_name": "Afterglow",
  "version": "1.3.1",
  "description": "A calm, modern Chrome theme built from the Rosé Pine palette.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "theme": {
    "images": {
